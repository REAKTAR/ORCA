BHASHINI_USER_ID=your-ulca-user-id
BHASHINI_API_KEY=your-ulca-api-key
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd

# Level-2 orchestrator (orchestrator.py) — any provider LangChain supports.
#
# Zero-budget option for a student team: Google AI Studio's Gemini API is
# genuinely free (no card) for the Flash-class models — good enough for
# tool-calling. Get a key at aistudio.google.com, then:
#   pip install langchain-google-genai
#   ORCA_LLM_PROVIDER=google_genai
#   ORCA_LLM_MODEL=gemini-2.5-flash   (check AI Studio for the current free model list)
#   GOOGLE_API_KEY=your-google-key
#
# Default below uses Anthropic instead (needs a small paid credit, no
# permanent free tier). Swap ORCA_LLM_PROVIDER=openai + `pip install
# langchain-openai` + OPENAI_API_KEY for OpenAI instead.
ORCA_LLM_PROVIDER=anthropic
ORCA_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=your-anthropic-key
